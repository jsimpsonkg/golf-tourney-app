{
  // Root config exists for one reason: Vercel compiles `api/index.ts` (and the
  // server sources it pulls in) using the tsconfig.json at the project root.
  // Without this it falls back to builder defaults, which is a moving target.
  // The client and server keep their own configs and are unaffected.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS on purpose, and the root package.json must NOT have
    // "type": "module". The server sources use extensionless relative imports
    // ("./routes/index", "../db/index"); ESM output refuses to resolve those
    // without .js on every one, which is the churn gotcha #2 in
    // docs/hosting.md warns about. CJS require() infers the extension, so the
    // function loads as-is. Emit format and the absence of "type": "module"
    // are a pair — change both or neither.
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["api"]
}
