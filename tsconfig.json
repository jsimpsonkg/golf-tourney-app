{
  // Root config exists for one reason: Vercel compiles `api/index.ts` (and the
  // server sources it pulls in) using the tsconfig.json at the project root.
  // Without this it falls back to builder defaults, which is a moving target.
  // The client and server keep their own configs and are unaffected.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // "preserve" means the emitted function keeps ESM syntax, so the root
    // package.json MUST keep "type": "module" — otherwise the Vercel runtime
    // loads /var/task/api/index.js as CommonJS and every request 500s with
    // "Cannot use import statement outside a module". The two are a pair:
    // change both or neither.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["api"]
}
